{
    "github.copilot.git.commitMessageLanguage": "zh-CN",
    "java.compile.nullAnalysis.mode": "automatic",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "files.watcherExclude": {
        "**/target": true
    },
    
    "files.associations": {
        "*.dbclient-js": "javascript",
        "format": "c",
        "optional": "c",
        "tuple": "c",
        "type_traits": "c",
        "algorithm": "c",
        "array": "c",
        "atomic": "c",
        "bit": "c",
        "cassert": "c",
        "cctype": "c",
        "cerrno": "c",
        "charconv": "c",
        "climits": "c",
        "cmath": "c",
        "compare": "c",
        "concepts": "c",
        "cstddef": "c",
        "cstdint": "c",
        "cstdio": "c",
        "cstdlib": "c",
        "cstring": "c",
        "ctime": "c",
        "cwchar": "c",
        "string": "c",
        "unordered_map": "c",
        "exception": "c",
        "memory": "c",
        "memory_resource": "c",
        "ratio": "c",
        "string_view": "c",
        "utility": "c",
        "functional": "c",
        "initializer_list": "c",
        "iosfwd": "c",
        "iterator": "c",
        "limits": "c",
        "locale": "c",
        "new": "c",
        "ostream": "c",
        "semaphore": "c",
        "span": "c",
        "stdexcept": "c",
        "stop_token": "c",
        "thread": "c",
        "typeinfo": "c",
        "version": "c",
        "*.rh": "c",
        "bitset": "c",
        "random": "c",
        "istream": "c",
        "numeric": "c",
        "streambuf": "c",
        "forward_list": "c",
        "fstream": "c",
        "ranges": "c",
        "variant": "c",
        "stdlib.h": "c",
        "complex": "c",
        "*.inc": "c"
    },
    "java.debug.settings.onBuildFailureProceed": true,
        "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.env.windows": {
        "PYTHONIOENCODING": "utf-8"
    },
        // 设置默认编码为 UTF-8 with BOM
    "files.encoding": "utf8bom",
    
    // 为特定语言设置编码
    "[c]": {
        "files.encoding": "utf8bom"
    },
    "[cpp]": {
        "files.encoding": "utf8bom"
    },
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],

}